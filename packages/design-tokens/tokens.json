{
  "$schema": "internal://deallens/design-tokens",
  "name": "deallens-tokens",
  "description": "Canonical DealLens design tokens (PRD §21). Source of truth is apps/web/app/globals.css; this JSON is the exported artifact consumed by the PDF renderer and email templates.",
  "themes": {
    "dark": {
      "surface": { "canvas": "#0a0d14", "panel": "#0e1219", "card": "#121722", "raise": "#171d2b", "overlay": "#1b2233" },
      "stroke": { "default": "#1e2635", "strong": "#2a3448", "hairline": "rgba(148,163,199,0.09)" },
      "ink": { "primary": "#e9edf6", "secondary": "#a4aec6", "muted": "#66718c", "faint": "#454f66" },
      "accent": { "default": "#5e7cff", "hover": "#7d95ff", "soft": "rgba(94,124,255,0.13)", "ink": "#b7c5ff" },
      "grade": { "a": "#2fd37f", "b": "#9ade4b", "c": "#f2c239", "d": "#f59e4b", "f": "#f16a5e" },
      "delta": { "pos": "#2fd37f", "neg": "#f16a5e" },
      "danger": "#e5484d",
      "viz": ["#5e7cff", "#22d3ee", "#a78bfa", "#f472b6", "#fbbf24", "#2dd4bf"]
    },
    "light": {
      "surface": { "canvas": "#f5f6f9", "panel": "#fbfcfd", "card": "#ffffff", "raise": "#f2f4f8", "overlay": "#ffffff" },
      "stroke": { "default": "#e3e7ef", "strong": "#cdd4e1", "hairline": "rgba(23,32,56,0.08)" },
      "ink": { "primary": "#161b26", "secondary": "#4d5871", "muted": "#8590a6", "faint": "#aeb7c9" },
      "accent": { "default": "#4560e6", "hover": "#3149c9", "soft": "rgba(69,96,230,0.10)", "ink": "#3149c9" },
      "grade": { "a": "#0e9f5c", "b": "#689812", "c": "#b98a04", "d": "#d9640e", "f": "#d9433a" },
      "delta": { "pos": "#0e9f5c", "neg": "#d9433a" },
      "danger": "#d92d31",
      "viz": ["#4560e6", "#0e97b5", "#7c58d8", "#d34f92", "#c78a08", "#0d9e8d"]
    }
  },
  "typography": {
    "sans": "Geist Sans",
    "mono": "Geist Mono",
    "rule": "Mono speaks data (all numerals, labels, eyebrows — tabular figures); sans speaks prose.",
    "scale": { "2xs": 11, "xs": 12, "sm": 13, "base": 14, "lg": 16, "xl": 18, "2xl": 22, "3xl": 28, "4xl": 34 }
  },
  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 10, "xl": 14 },
  "spacing": { "grid": 8, "gutterDesktop": 24, "gutterMobile": 16 },
  "motion": {
    "swift": "cubic-bezier(0.21, 0.61, 0.35, 1)",
    "durations": { "micro": 150, "standard": 200, "entrance": 350 },
    "rule": "Respect prefers-reduced-motion; entrance animations never exceed 400ms."
  },
  "grades": {
    "bands": { "A": [85, 100], "B": [70, 84.99], "C": [55, 69.99], "D": [40, 54.99], "F": [0, 39.99] },
    "rule": "Grade color + letter always travel together (map pins, tables, chips, PDFs) — color is never the only signal."
  }
}
