# Copy to .env and fill in real values. Never commit .env.
# In staging/prod these are injected via AWS Secrets Manager (see docs/02-TECHNICAL-DESIGN.md §15) — this
# file is for local dev only.

# --- Database ---
# App runtime: least-privilege role, subject to RLS (created by migration 0001).
DATABASE_URL=postgresql+asyncpg://deallens_app:deallens_app_dev@localhost:5432/deallens
# Owner role: migrations + system_session() bootstrap paths only. Never serves a request.
DATABASE_URL_SYSTEM=postgresql+asyncpg://deallens:deallens_dev@localhost:5432/deallens
DATABASE_URL_SYNC=postgresql+psycopg://deallens:deallens_dev@localhost:5432/deallens

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3 in staging/prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=deallens
S3_SECRET_ACCESS_KEY=deallens_dev_minio
S3_BUCKET=deallens-dev

# --- Clerk (https://dashboard.clerk.com — create a dev instance) ---
# Backend verifies session JWTs locally via JWKS; only the issuer/JWKS URL and the
# webhook signing secret are needed server-side (never the secret key in client code).
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# --- apps/web (Next.js, public + server) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CLERK_SECRET_KEY=sk_test_replace_me

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SESSION_ISSUER_LEEWAY_SECONDS=10
ACCOUNT_DELETION_GRACE_DAYS=30
